<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truth or Dare - Professional Edition</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f1f5f9;
            --card-bg: rgba(255, 255, 255, 0.8);
            --text-main: #0f172a;
            --text-muted: #64748b;
            --primary: #4f46e5;
            --secondary: #db2777;
            --border: rgba(255, 255, 255, 0.8);
            --inner-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.4);
            --outer-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        [data-theme="dark"] {
            --bg-color: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --primary: #6366f1;
            --secondary: #ec4899;
            --border: rgba(255, 255, 255, 0.1);
            --inner-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.05);
            --outer-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
        }

        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
            outline: none;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            transition: background-color 0.4s ease;
        }

        .container {
            width: 90%;
            max-width: 400px;
            position: relative;
        }

        .main-card {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border);
            border-radius: 32px;
            padding: 2.5rem 1.5rem;
            box-shadow: var(--outer-shadow);
            box-shadow: var(--outer-shadow), var(--inner-shadow);
            text-align: center;
            transition: transform 0.3s ease;
        }

        .screen { display: none; }
        .screen.active { 
            display: flex; 
            flex-direction: column; 
            animation: fadeIn 0.4s ease-out; 
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h1 { font-size: 1.75rem; font-weight: 800; margin: 0 0 0.5rem; letter-spacing: -0.03em; }
        .subtitle { color: var(--text-muted); margin-bottom: 2rem; font-size: 0.9rem; font-weight: 500; }

        .theme-toggle {
            position: absolute;
            top: -60px;
            right: 0;
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            width: 40px;
            height: 40px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-main);
            box-shadow: var(--outer-shadow);
        }

        .category-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .cat-item {
            background: rgba(128, 128, 128, 0.05);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 1.5rem 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .cat-item:hover {
            background: rgba(128, 128, 128, 0.1);
            transform: translateY(-2px);
        }

        .cat-item .icon { font-size: 1.75rem; margin-bottom: 8px; }
        .cat-item .label { font-weight: 700; font-size: 0.85rem; }

        .btn-stack { margin-top: 1rem; display: flex; flex-direction: column; gap: 10px; }

        .btn {
            border: none;
            border-radius: 16px;
            padding: 1rem;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            width: 100%;
        }

        .btn-truth { background: var(--primary); color: white; }
        .btn-dare { background: var(--secondary); color: white; }
        .btn-ghost { 
            background: transparent; 
            border: 1px solid var(--border); 
            color: var(--text-muted);
            margin-top: 5px;
        }
        .btn-ghost:hover { color: var(--text-main); background: rgba(128, 128, 128, 0.05); }

        .prompt-box {
            min-height: 140px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 1.5rem;
            border-radius: 24px;
            background: rgba(128, 128, 128, 0.04);
            margin: 1.5rem 0;
            border: 1px solid var(--border);
        }

        .type-tag {
            font-size: 0.65rem;
            font-weight: 800;
            letter-spacing: 0.1em;
            margin-bottom: 1rem;
            padding: 4px 12px;
            border-radius: 10px;
            color: white;
            text-transform: uppercase;
        }

        .prompt-content { font-size: 1.15rem; font-weight: 600; line-height: 1.5; }

        .meta { margin-top: 2rem; font-size: 0.8rem; color: var(--text-muted); }
        .reset-btn { color: var(--secondary); cursor: pointer; text-decoration: underline; margin-top: 8px; display: inline-block; }

        /* Modal */
        #modal-wrap {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            backdrop-filter: blur(4px);
        }
        #modal-wrap.show { display: flex; }

        .modal {
            background: var(--bg-color);
            border-radius: 24px;
            padding: 2rem;
            width: 85%;
            max-width: 320px;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
        }

        .hidden { display: none !important; }
    </style>
</head>
<body>

    <div class="container">
        <button class="theme-toggle" id="theme-switcher">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>

        <div class="main-card">
            <!-- Main Menu -->
            <div id="view-menu" class="screen active">
                <h1>Truth or Dare</h1>
                <p class="subtitle">Select a category to play</p>
                <div class="category-grid" id="category-grid"></div>
                <div class="meta">
                    <span id="stat-count">0 cards played</span><br>
                    <span class="reset-btn" onclick="askReset()">Reset Data</span>
                </div>
            </div>

            <!-- Selection View -->
            <div id="view-choice" class="screen">
                <h2 id="view-cat-title" style="margin-bottom:0">Category</h2>
                <p class="subtitle">Pick your side</p>
                <div class="btn-stack">
                    <button class="btn btn-truth" onclick="revealTask('truth')">Truth</button>
                    <button class="btn btn-dare" onclick="revealTask('dare')">Dare</button>
                    <button class="btn btn-ghost" onclick="goHome()">Back to Menu</button>
                </div>
            </div>

            <!-- Task View -->
            <div id="view-task" class="screen">
                <div class="prompt-box">
                    <div id="task-tag" class="type-tag">TRUTH</div>
                    <div id="task-text" class="prompt-content">Prompt text here...</div>
                </div>
                <div class="btn-stack">
                    <button class="btn btn-truth" onclick="goBackToChoice()">Next Player</button>
                    <button class="btn btn-ghost" onclick="goHome()">Finish Session</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reset Confirmation -->
    <div id="modal-wrap">
        <div class="modal">
            <h3 style="margin-top:0">Clear Progress?</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">This will allow all previously used prompts to appear again.</p>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <button class="btn btn-truth" onclick="confirmReset()">Clear History</button>
                <button class="btn btn-ghost" style="margin:0" onclick="hideModal()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
// Merge new 'sus' category if not present to ensure it's available with others
const SUS_CATEGORY = {
    truth: [
        "What's the hottest dream you've ever had about someone in this room?",
        "What's the most embarrassing thing you've done while masturbating?",
        "Have you ever had a one-night stand? Who was it with?",
        "What's your favorite position and why?",
        "What's the wildest place you've ever had sex?",
        "Have you ever sent or received nudes? Tell the story.",
        "What's a kink or fantasy you've never told anyone?",
        "Who in this group would you most want to hook up with?",
        "What's the last porn category you watched?",
        "Have you ever had sex in public? What happened?"
    ],
    dare: [
        "Give the person to your left a lap dance for 30 seconds.",
        "Let the group choose an item of clothing for you to remove.",
        "Kiss the person on your right on the neck for 10 seconds.",
        "Moan seductively every time someone says your name for the next 2 rounds.",
        "Send a spicy text to your most recent crush right now.",
        "Let someone blindfold you and feed you something with their fingers.",
        "Do a striptease for 20 seconds (clothes stay on, but make it hot).",
        "Whisper something dirty in the ear of the person across from you.",
        "Let the group rate your kissing technique on a scale of 1-10 after you kiss someone.",
        "Remove one piece of clothing every time you laugh for the rest of the round."
    ]
};
const DATABASE = {
    random: {
        truth: [
            "What's the last lie you told and why?",
            "What's the most embarrassing thing you've done on a date?",
            "Who in this room do you find the most attractive?",
            "What's your biggest ick in a potential partner?",
            "Have you ever had a crush on someone in this group?",
            "What's the pettiest thing you've ever done to someone?",
            "What's the weirdest thing you've ever searched on your phone at 2 AM?",
            "What's one secret you've never told anyone in this room?",
            "What's the most awkward text you've ever sent by accident?",
            "If you could swap lives with one person here for a full day, who would it be and why?"
        ],
        dare: [
            "Do your best impression of the person to your left until someone guesses who it is.",
            "Let the group send one text from your phone to anyone they want (you have to hit send).",
            "Speak in a ridiculous accent for the next 3 rounds.",
            "Let someone in the group style your hair however they want and keep it for the rest of the game.",
            "Do 15 push-ups while singing your favorite song loudly.",
            "Smell the armpit of the person on your right.",
            "Post a silly selfie to your Instagram story right now (no deleting for 24 hours).",
            "Try to lick your own elbow (or make a dramatic attempt).",
            "Give a 30-second stand-up comedy routine about your life.",
            "Swap one item of clothing with the person next to you for the next two rounds."
        ]
    },
    fun: {
        truth: [
            "What's the funniest thing that happened to you this month?",
            "If you were an animal, what would you be and why?",
            "What's your most useless talent?",
            "What's the best prank you've ever pulled or had pulled on you?",
            "What's your guilty pleasure song or movie that you’d be embarrassed to admit?",
            "What's the weirdest food combination you actually love?",
            "Have you ever walked in on your parents doing something awkward?",
            "What's the cringiest thing you've said while trying to flirt?",
            "What's your most bizarre nickname and how did you get it?",
            "If you could only eat one meal for the rest of your life, what would it be?"
        ],
        dare: [
            "Act like a dramatic news reporter announcing the most ridiculous version of your day.",
            "Try to juggle three random items the group chooses.",
            "Make up a 20-second rap about the person to your right.",
            "Speak only in questions for the next two rounds.",
            "Do your best celebrity impression for 30 seconds.",
            "Try to stand on one leg with your eyes closed for 30 seconds.",
            "Let the group draw something silly on your arm with a pen.",
            "Sing the chorus of a song but in the voice of a cartoon character.",
            "Dance like nobody's watching for a full minute.",
            "Recreate your best (or worst) dance move from middle school."
        ]
    },
    weird: {
        truth: [
            "What's the most unhinged thing you've ever done at 3 AM?",
            "Have you ever tasted your own sweat on purpose?",
            "If your life was a horror movie, what would be the dumbest way you die?",
            "What's the weirdest thing you've ever done with your bare feet?",
            "Have you ever named an object in your house and talked to it regularly?",
            "What's the most cursed search history entry you have right now?",
            "If you could replace one of your body parts with something completely random, what would it be?",
            "Have you ever licked something off the floor or ground?",
            "What's the strangest conspiracy theory you secretly believe (even a little)?",
            "If you woke up tomorrow with an extra limb, where would you want it and what would you do with it first?"
        ],
        dare: [
            "Lick the bottom of your shoe (or dramatically pretend if it's too gross).",
            "Talk to your own reflection like it's a therapy session for 30 seconds.",
            "Smell every person's feet in the room and rank them from best to worst.",
            "Pretend you're a possessed doll for the next full round.",
            "Eat a spoonful of whatever condiment is in the fridge without making a face.",
            "Walk around the room backwards while making dinosaur noises.",
            "Let the group choose one item in the room for you to French kiss.",
            "Bark like a dog every time someone says your name for the next two rounds.",
            "Try to fit as many marshmallows in your mouth as possible while saying 'I'm a weird little creature'.",
            "Act out how you would seduce an alien if they landed in the room right now."
        ]
    },
    embarrassing: {
        truth: [
            "What's the cringiest thing you did as a kid that still haunts you?",
            "Have you ever waved at someone thinking they were waving at you, but they weren't?",
            "What's the most awkward thing you've ever said to a crush?",
            "Have you ever had a major wardrobe malfunction in public?",
            "What's the most embarrassing photo or video of you that exists?",
            "Have you ever peed yourself as an adult?",
            "What's the dumbest thing you've done to impress someone?",
            "Have you ever accidentally liked an old post while stalking someone's profile?",
            "What's the most embarrassing thing you've googled?",
            "Have you ever sent a text to the wrong person that was meant to be a secret?"
        ],
        dare: [
            "Show the group the most embarrassing photo in your camera roll right now.",
            "Let the group give you a ridiculous makeover with whatever they have.",
            "Sing a song with a mouthful of water without spilling (or try dramatically).",
            "Do your most awkward dance move in front of everyone for 20 seconds.",
            "Draw a self-portrait with your eyes closed and show it to the group.",
            "Call a friend or family member and sing 'Happy Birthday' to them right now.",
            "Read the last text you sent out loud in the most dramatic voice possible.",
            "Let someone tickle you for 20 seconds while you try not to laugh.",
            "Wear your socks on your hands for the next two rounds.",
            "Recreate your most embarrassing moment as dramatically as possible."
        ]
    }
};
// Ensure 'sus' is merged/added in case of future extension
if (!DATABASE.sus) {
    DATABASE.sus = SUS_CATEGORY;
}

        // Initialize or load used cards for all categories
        const CATEGORY_KEYS = Object.keys(DATABASE);
        let usedCards = JSON.parse(localStorage.getItem('td_v3_data')) || {};
        CATEGORY_KEYS.forEach(key => {
            if (!usedCards[key]) usedCards[key] = [];
        });

        let currentCatKey = '';

        function navigate(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('view-' + id).classList.add('active');
        }

        function startCat(key) {
            currentCatKey = key;
            document.getElementById('view-cat-title').innerText = key.charAt(0).toUpperCase() + key.slice(1);
            navigate('choice');
        }

        function revealTask(type) {
            const list = DATABASE[currentCatKey][type];
            const fresh = list.filter(p => !usedCards[currentCatKey].includes(p));
            
            let selection;
            const tag = document.getElementById('task-tag');
            tag.style.background = type === 'truth' ? 'var(--primary)' : 'var(--secondary)';
            tag.innerText = type;

            if (fresh.length === 0) {
                selection = "All cards in this category used! Reset progress to play again.";
                tag.style.background = "#94a3b8";
            } else {
                selection = fresh[Math.floor(Math.random() * fresh.length)];
                usedCards[currentCatKey].push(selection);
                localStorage.setItem('td_v3_data', JSON.stringify(usedCards));
            }

            document.getElementById('task-text').innerText = selection;
            updateUI();
            navigate('task');
        }

        function goBackToChoice() { navigate('choice'); }
        function goHome() { navigate('menu'); }
        function updateUI() {
            // Show total number of played cards across all categories
            let total = 0;
            Object.values(usedCards).forEach(arr => { if (Array.isArray(arr)) total += arr.length; });
            document.getElementById('stat-count').innerText = `${total} cards played`;
        }

        function askReset() { document.getElementById('modal-wrap').classList.add('show'); }
        function hideModal() { document.getElementById('modal-wrap').classList.remove('show'); }
        function confirmReset() {
            // Reset usedCards for all categories
            usedCards = {};
            CATEGORY_KEYS.forEach(key => { usedCards[key] = []; });
            localStorage.removeItem('td_v3_data');
            updateUI();
            hideModal();
        }

        // Theme Handling with localStorage persistence
        const themeBtn = document.getElementById('theme-switcher');

        function applyTheme(theme) {
            document.body.setAttribute('data-theme', theme);
            localStorage.setItem('td_theme_v3', theme);
        }

        themeBtn.onclick = () => {
            const current = document.body.getAttribute('data-theme');
            applyTheme(current === 'dark' ? 'light' : 'dark');
        };

        window.onload = () => {
            const saved = localStorage.getItem('td_theme_v3') || 'light';
            applyTheme(saved);
            updateUI();
        };
    // Category icon mapping and dynamic rendering
    const CATEGORY_ICONS = {
        random: '🎲',
        fun: '✨',
        weird: '🌀',
        embarrassing: '😅',
        sus: '🔥' // Icon for the new 'sus' category
    };

    function renderCategories() {
        const grid = document.getElementById('category-grid');
        grid.innerHTML = '';
        Object.keys(DATABASE).forEach(key => {
            const div = document.createElement('div');
            div.className = 'cat-item';
            div.onclick = () => startCat(key);
            div.innerHTML = `<span class="icon">${CATEGORY_ICONS[key] || '❓'}</span>
                             <span class="label">${key.charAt(0).toUpperCase() + key.slice(1)}</span>`;
            grid.appendChild(div);
        });
    }

    renderCategories();
    </script>
</body>
</html>
